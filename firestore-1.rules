rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios autenticados pueden leer y escribir.
    // Como solo existirán 2 cuentas (Pablo y Laura, creadas a mano
    // en la Consola de Firebase, sin registro público), esto basta
    // para que únicamente vosotros dos tengáis acceso.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
